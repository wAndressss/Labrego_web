# Copia este archivo como .env.local (en tu PC) o crea estas variables en
# Vercel → Project → Settings → Environment Variables.

# Cuenta de Gmail que envía las cotizaciones (labregooficial@gmail.com)
SMTP_USER=labregooficial@gmail.com
# "Contraseña de aplicación" de Google (16 letras), NO la contraseña normal.
# Se crea en https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos)
SMTP_PASS=

# Correo donde llegan las órdenes de venta confirmadas (por defecto SMTP_USER)
ORDERS_EMAIL=labregooficial@gmail.com

# Clave secreta para firmar los enlaces de "Confirmar pedido".
# Escribe una frase larga y aleatoria (mínimo 16 caracteres) y no la compartas.
QUOTE_SECRET=

# Dirección pública del sitio, para los enlaces de los correos
# (en tu PC: http://localhost:5173)
SITE_URL=http://localhost:5173
